<widgets:WidgetWindowBase x:Class="AiDesk.App.Widgets.MusicWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:AiDesk.App.Widgets"
        Title="音乐" Width="248" SizeToContent="Height">
    <Border Style="{StaticResource WidgetCard}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="MusicCover" Width="56" Height="56" Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Name="MusicTitle" Text="未在播放" FontSize="13" FontWeight="SemiBold"
                           Foreground="#E8ECF2" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                <TextBlock x:Name="MusicArtist" Text="正在监听系统媒体…" FontSize="11"
                           Foreground="#8A94A3" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="⏮" Width="26" Height="26" FontSize="11" Background="Transparent"
                            BorderThickness="0" Foreground="#CCFFFFFF" Cursor="Hand" Click="OnPrevClicked" />
                    <Button x:Name="PlayBtn" Content="▶" Width="26" Height="26" FontSize="11"
                            Background="Transparent" BorderThickness="0" Foreground="#CCFFFFFF"
                            Cursor="Hand" Margin="6,0,0,0" Click="OnPlayClicked" />
                    <Button Content="⏭" Width="26" Height="26" FontSize="11" Background="Transparent"
                            BorderThickness="0" Foreground="#CCFFFFFF" Cursor="Hand" Margin="6,0,0,0" Click="OnNextClicked" />
                </StackPanel>
            </StackPanel>
            <Button Content="✕" Width="20" Height="20" FontSize="9" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,-8,-8,0" Background="Transparent"
                    Foreground="#66FFFFFF" BorderThickness="0" Cursor="Hand"
                    Click="OnCloseClicked" ToolTip="关闭小组件" />
        </Grid>
    </Border>
</widgets:WidgetWindowBase>
