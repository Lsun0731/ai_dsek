<widgets:WidgetWindowBase x:Class="AiDesk.App.Widgets.WeatherWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:AiDesk.App.Widgets"
        Title="天气" Width="224" SizeToContent="Height">

    <Border Style="{StaticResource WidgetCard}">
        <Grid>
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="CityText" Text="北京" FontSize="13" FontWeight="SemiBold"
                               Foreground="#202124" VerticalAlignment="Center" />
                    <Button x:Name="RefreshBtn" Content="⟳" Width="24" Height="24" FontSize="12"
                            HorizontalAlignment="Right" Background="Transparent" Foreground="#5F6368"
                            BorderThickness="0" Cursor="Hand" Click="OnRefreshClicked" ToolTip="刷新天气" />
                </Grid>

                <Grid Margin="0,10,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="IconText" Text="⛅" FontSize="30" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TempText" Text="--°" FontSize="32" FontWeight="Light" Foreground="#202124"
                                   FontFamily="Segoe UI Light, Microsoft YaHei UI" />
                        <TextBlock x:Name="DescText" Text="加载中…" FontSize="12" Foreground="#5F6368" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="DetailText" Text="湿度 --% · 风 -- km/h · 今日 -- ~ --°"
                           FontSize="11" Foreground="#80868B" TextWrapping="Wrap" />
            </StackPanel>
            <Button Content="✕" Width="20" Height="20" FontSize="9" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,-8,-8,0" Background="Transparent"
                    Foreground="#80868B" BorderThickness="0" Cursor="Hand"
                    Click="OnCloseClicked" ToolTip="关闭小组件" />
        </Grid>
    </Border>
</widgets:WidgetWindowBase>
