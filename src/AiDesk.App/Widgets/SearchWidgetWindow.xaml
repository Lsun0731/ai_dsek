<widgets:WidgetWindowBase x:Class="AiDesk.App.Widgets.SearchWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:AiDesk.App.Widgets"
        Title="搜索" Width="640" SizeToContent="Height">

    <widgets:WidgetWindowBase.Resources>
        <!-- ═══ Win11 Mica 风格（方角 4-8、米卡浅灰、系统蓝 #0067C0） ═══ -->

        <!-- Tab 按钮：选中 = 浅蓝底 + 蓝字 + SemiBold -->
        <Style x:Key="TabToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#5F6368" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A0067C0" />
                                <Setter Property="Foreground" Value="#0067C0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#12000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索结果行：选中 = 浅蓝底，悬停 = 浅灰 -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="10,7" Margin="4,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F0067C0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#12000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 剪贴板条目：白色小卡片 -->
        <Style x:Key="ClipItemStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#12000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="12,8" Margin="6,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFEDEFF2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 翻页小按钮：灰字透明 -->
        <Style x:Key="PageNavStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#80868B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#12000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部主按钮：实心系统蓝 -->
        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0067C0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0057A8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#004E96" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 折叠开关按钮 -->
        <Style x:Key="FoldButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#80868B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#12000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </widgets:WidgetWindowBase.Resources>

    <!-- Mica 面板：米卡浅灰渐变 + 方角 8 + 浅阴影 -->
    <Border CornerRadius="8" BorderBrush="#14000000" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF5F5F5" Offset="0" />
                <GradientStop Color="#FFE9EBEE" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#FF000000" Opacity="0.18" BlurRadius="18" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ 顶部 Tab 栏 ═══ -->
            <Grid Margin="12,8,12,0">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="SearchTabBtn" Content="🔍 搜索" Style="{StaticResource TabToggleStyle}"
                                  IsChecked="True" Click="OnSearchTabClick" />
                    <ToggleButton x:Name="ClipTabBtn" Content="📋 剪贴板" Style="{StaticResource TabToggleStyle}"
                                  Margin="4,0,0,0" Click="OnClipTabClick" />
                    <ToggleButton x:Name="AITabBtn" Content="🤖 AI 对话" Style="{StaticResource TabToggleStyle}"
                                  Margin="4,0,0,0" Click="OnAITabClick" />
                </StackPanel>
                <Button Content="✕" Grid.Column="1" HorizontalAlignment="Right"
                        Style="{StaticResource PageNavStyle}" Click="OnCloseClick" />
            </Grid>
            <Border Grid.Row="1" Height="1" Margin="16,8,16,0" Background="#1C000000" />

            <!-- ═══ 页面一：搜索 ═══ -->
            <Grid Grid.Row="2" x:Name="SearchPage" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 输入区：白色输入卡片 -->
                <Border Grid.Row="0" Margin="16,10,16,0" Background="#FFFFFFFF" CornerRadius="4"
                        BorderBrush="#14000000" BorderThickness="1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="13" Foreground="#5F6368" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="13.5" FontWeight="Medium"
                                 Foreground="#202124" CaretBrush="#0067C0" Background="Transparent"
                                 BorderThickness="0" Margin="10,0,0,0"
                                 TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
                    </Grid>
                </Border>

                <!-- 结果区：左列表 + 右预览 -->
                <Grid Grid.Row="2" Margin="12,10,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="228" />
                    </Grid.ColumnDefinitions>

                    <!-- 结果列表 -->
                    <ListBox x:Name="ResultList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnResultSelectionChanged"
                             KeyDown="OnResultKeyDown"
                             MouseDoubleClick="OnResultDoubleClick"
                             MaxHeight="264">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#202124"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Dir}" FontSize="9.5" Foreground="#80868B"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 详情预览：白色卡片 -->
                    <Border Grid.Column="1" CornerRadius="4" Background="#FFFFFFFF"
                            BorderBrush="#12000000" BorderThickness="1" Margin="10,0,0,0"
                            Padding="14,12" VerticalAlignment="Top" MinHeight="120">
                        <StackPanel x:Name="PreviewPanel">
                            <StackPanel x:Name="PreviewEmpty">
                                <TextBlock Text="选中应用查看详情" FontSize="11" Foreground="#80868B"
                                           HorizontalAlignment="Center" Margin="0,36,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="PreviewDetail" Visibility="Collapsed">
                                <Image x:Name="PreviewIcon" Width="52" Height="52" Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="PreviewName" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="#202124" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                <TextBlock x:Name="PreviewType" Text="应用程序" FontSize="9.5"
                                           Foreground="#80868B" TextAlignment="Center" Margin="0,3,0,0" />
                                <Border Height="1" Background="#1C000000" Margin="0,8,0,6" />
                                <TextBlock Text="位置" FontSize="9" Foreground="#80868B" />
                                <TextBlock x:Name="PreviewPath" FontSize="9.5" Foreground="#5F6368"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 底部操作条 -->
                <Grid Grid.Row="3" Margin="16,4,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="🤖  AI 对话" Style="{StaticResource FooterButtonStyle}" Click="OnAIButtonClick" />
                    <TextBlock Grid.Column="1" Text="Esc 关闭 · ↑↓ 选择 · 回车启动"
                               FontSize="10" Foreground="#9AA0A6" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="12,0,4,0" />
                </Grid>
            </Grid>

            <!-- ═══ 页面二：剪贴板 ═══ -->
            <Grid Grid.Row="2" x:Name="ClipPage" Margin="0,4,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏：折叠 + 标题 | 分页 -->
                <Grid Margin="16,8,16,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FoldBtn" Content="▾" Style="{StaticResource FoldButtonStyle}"
                                Click="OnFoldClick" />
                        <TextBlock Text="剪贴板历史" FontSize="11.5" Foreground="#3C4043"
                                   VerticalAlignment="Center" Margin="2,0,0,0" />
                        <TextBlock x:Name="ClipCount" FontSize="10" Foreground="#9AA0A6"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="PrevPageBtn" Content="◀" Style="{StaticResource PageNavStyle}"
                                Click="OnPrevPage" />
                        <TextBlock x:Name="PageIndicator" Text="1/1" FontSize="10.5" Foreground="#80868B"
                                   Margin="8,0" VerticalAlignment="Center" />
                        <Button x:Name="NextPageBtn" Content="▶" Style="{StaticResource PageNavStyle}"
                                Click="OnNextPage" />
                    </StackPanel>
                </Grid>

                <!-- 折叠区：分隔线 + 列表 -->
                <StackPanel Grid.Row="1" Grid.RowSpan="2" x:Name="ClipFoldArea">
                    <Border Height="1" Margin="16,0" Background="#1C000000" />
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                        <StackPanel>
                            <ItemsControl x:Name="ClipList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ClipItemStyle}" Tag="{Binding}"
                                                Click="OnClipItemClick">
                                            <Grid>
                                                <TextBlock Text="📋" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="#3C4043"
                                                           TextTrimming="CharacterEllipsis" Margin="28,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ClipEmpty" Text="（暂无剪贴板历史）" FontSize="11.5"
                                       Foreground="#9AA0A6" Margin="22,8,0,12" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- 底部操作条 -->
                <Grid Grid.Row="3" Margin="16,8,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="🤖  AI 对话" Style="{StaticResource FooterButtonStyle}" Click="OnAIButtonClick" />
                    <TextBlock Grid.Column="1" Text="点击条目复制 · Esc 关闭"
                               FontSize="10" Foreground="#9AA0A6" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="12,0,4,0" />
                </Grid>
            </Grid>
            <!-- ═══ 页面三：AI 对话（文字聊天 + Agent 工具） ═══ -->
            <Grid Grid.Row="2" x:Name="AIPage" Margin="0,4,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 音色设置行 -->
                <Grid Margin="16,6,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="宠物音色" FontSize="11" Foreground="#5F6368" VerticalAlignment="Center" />
                        <ComboBox x:Name="VoiceBox" Margin="8,0,0,0" Width="210" Height="26" FontSize="11"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectionChanged="OnVoiceChanged" />
                    </StackPanel>
                </Grid>

                <!-- 聊天记录 -->
                <ScrollViewer Grid.Row="1" x:Name="ChatScroll" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="8,6,8,0">
                    <ItemsControl x:Name="ChatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,3">
                                    <Border x:Name="bubble" MaxWidth="400" CornerRadius="8" Padding="10,8"
                                            HorizontalAlignment="Left" Background="#FFF1F3F4">
                                        <TextBlock x:Name="txt" Text="{Binding Text}" TextWrapping="Wrap"
                                                   FontSize="12" Foreground="#202124" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                        <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="bubble" Property="Background" Value="#0067C0" />
                                        <Setter TargetName="txt" Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 输入行 -->
                <Grid Grid.Row="2" Margin="16,8,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChatInput" FontSize="12.5" Padding="10,7" Background="#FFFFFFFF"
                             BorderBrush="#14000000" BorderThickness="1" Foreground="#202124"
                             VerticalContentAlignment="Center" KeyDown="OnChatKeyDown" />
                    <Button Grid.Column="1" Content="发送" Margin="8,0,0,0" Background="#0067C0"
                            Foreground="White" BorderThickness="0" Padding="14,7" FontSize="11.5"
                            Cursor="Hand" Click="OnChatSendClicked" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</widgets:WidgetWindowBase>
