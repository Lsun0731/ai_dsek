<widgets:WidgetWindowBase x:Class="AiDesk.App.Widgets.SearchWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:AiDesk.App.Widgets"
        Title="搜索" Width="560" SizeToContent="Height">
    <!-- 命令面板风格：大输入框 + 结果列表 + 底部功能区 -->
    <Border Style="{StaticResource WidgetCard}" Padding="0">
        <StackPanel>
            <!-- 顶部输入框 -->
            <Grid Margin="18,16,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Foreground="#8A94A3" />
                <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="16" Foreground="#E8ECF2"
                         CaretBrush="#4C7CF3" Background="Transparent" BorderThickness="0"
                         Margin="10,0,0,0"
                         TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
            </Grid>
            <Border Height="1" Background="#22FFFFFF" />

            <!-- 结果区（搜索应用 / 剪贴板历史） -->
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 应用搜索结果 -->
                    <ListBox x:Name="SearchList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnSearchResultDoubleClick" Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,5">
                                    <TextBlock Text="📄" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E8ECF2"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 剪贴板历史 -->
                    <TextBlock x:Name="ClipTitle" Text="📋 剪贴板历史" FontSize="11" Foreground="#8A94A3"
                               Margin="16,12,0,6" />
                    <ItemsControl x:Name="ClipList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch"
                                        Click="OnClipItemClick" Tag="{Binding}">
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#D8DEE8"
                                               TextTrimming="CharacterEllipsis" Margin="16,5,16,5" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ClipEmpty" Text="（暂无剪贴板历史）" FontSize="12" Foreground="#6A7488"
                               Margin="16,4,0,12" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部功能区 -->
            <Border Height="1" Background="#22FFFFFF" />
            <StackPanel Orientation="Horizontal" Margin="12,8,12,12">
                <Button Content="📋 剪贴板" FontSize="12" Foreground="#D8DEE8" Background="#22FFFFFF"
                        BorderThickness="0" Padding="12,6" Cursor="Hand" Click="OnClipButtonClick" />
                <Button Content="🤖 AI 对话" FontSize="12" Foreground="#D8DEE8" Background="#22FFFFFF"
                        BorderThickness="0" Padding="12,6" Cursor="Hand" Margin="8,0,0,0"
                        Click="OnAIButtonClick" />
                <TextBlock Text="Esc 关闭 · 回车启动 · 点击剪贴板项复制" FontSize="10"
                           Foreground="#6A7488" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</widgets:WidgetWindowBase>
