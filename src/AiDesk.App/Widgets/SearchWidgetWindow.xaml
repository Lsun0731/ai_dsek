<widgets:WidgetWindowBase x:Class="AiDesk.App.Widgets.SearchWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:AiDesk.App.Widgets"
        Title="搜索" Width="600" SizeToContent="Height">

    <widgets:WidgetWindowBase.Resources>
        <!-- 应用磁贴样式（悬停高亮 + 轻微放大） -->
        <Style x:Key="TileStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="8" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 剪贴板条目（单行卡片，悬停高亮） -->
        <Style x:Key="ClipItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="14,8" Margin="12,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 翻页小按钮 -->
        <Style x:Key="PageNavStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#9AA5B5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部功能区按钮 -->
        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1EFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </widgets:WidgetWindowBase.Resources>

    <!-- 毛玻璃深色面板 -->
    <Border CornerRadius="18" BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0182136" Offset="0" />
                <GradientStop Color="#F00D111C" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#FF000000" Opacity="0.35" BlurRadius="26" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部输入区 -->
            <Grid Margin="22,18,22,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Foreground="#9AA5B5" />
                <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="16" FontWeight="SemiBold"
                         Foreground="#F0F3F8" CaretBrush="#4C7CF3" Background="Transparent"
                         BorderThickness="0" Margin="12,0,0,0"
                         TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
            </Grid>
            <Border Grid.Row="1" Height="1" Margin="22,0" Background="#1EFFFFFF" />

            <!-- 应用磁贴网格（无搜索=常用 12 个；搜索=过滤匹配） -->
            <ItemsControl x:Name="TileGrid" Grid.Row="2" Margin="20,16,20,18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileStyle}" Tag="{Binding App}" Click="OnTileClick">
                            <StackPanel HorizontalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="44" Height="44" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding App.Name}" FontSize="11" Foreground="#D8DEE8"
                                           TextTrimming="CharacterEllipsis" MaxWidth="88"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyText" Grid.Row="3" Text="未找到匹配的应用" FontSize="12.5"
                       Foreground="#7A8598" Margin="24,0,0,16" Visibility="Collapsed" />

            <!-- 剪贴板历史（分页标题行） -->
            <Grid Grid.Row="4" Margin="22,0,22,4">
                <TextBlock x:Name="ClipTitle" Text="剪贴板历史" FontSize="11.5" Foreground="#9AA5B5"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PrevPageBtn" Content="◀" Style="{StaticResource PageNavStyle}"
                            Click="OnPrevPage" />
                    <TextBlock x:Name="PageIndicator" Text="1/1" FontSize="11" Foreground="#9AA5B5"
                               Margin="6,0" VerticalAlignment="Center" />
                    <Button x:Name="NextPageBtn" Content="▶" Style="{StaticResource PageNavStyle}"
                            Click="OnNextPage" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="5" Height="1" Margin="22,0" Background="#1EFFFFFF" />

            <!-- 剪贴板列表 -->
            <ScrollViewer Grid.Row="6" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                <StackPanel>
                    <ItemsControl x:Name="ClipList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ClipItemStyle}" Tag="{Binding}"
                                        Click="OnClipItemClick">
                                    <Grid>
                                        <TextBlock Text="📋" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" FontSize="12.5" Foreground="#D8DEE8"
                                                   TextTrimming="CharacterEllipsis" Margin="30,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ClipEmpty" Text="（暂无剪贴板历史）" FontSize="12.5" Foreground="#7A8598"
                               Margin="24,6,0,12" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部功能区 -->
            <Border Grid.Row="7" Height="1" Margin="22,10,22,0" Background="#1EFFFFFF" />
            <Grid Grid.Row="8" Margin="16,10,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="🤖  AI 对话" FontSize="12" Foreground="#D8DEE8"
                        Style="{StaticResource FooterButtonStyle}" Click="OnAIButtonClick" />
                <TextBlock Grid.Column="1" Text="Esc 关闭 · 回车启动 · 点击条目复制"
                           FontSize="10.5" Foreground="#7A8598" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="12,0,4,0" />
            </Grid>
        </Grid>
    </Border>
</widgets:WidgetWindowBase>
