<widgets:WidgetWindowBase x:Class="AiDesk.App.Widgets.SearchWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:AiDesk.App.Widgets"
        Title="搜索" Width="580" SizeToContent="Height">

    <widgets:WidgetWindowBase.Resources>
        <!-- 悬停高亮条目样式（搜索项 / 剪贴板项通用） -->
        <Style x:Key="HoverItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="14,9" Margin="12,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 底部功能区按钮样式（圆角毛玻璃小按钮） -->
        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1EFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </widgets:WidgetWindowBase.Resources>

    <!-- 毛玻璃深色面板（Win11 现代风）：渐变玻璃底 + 大圆角 + 柔和阴影 + 蓝紫强调 -->
    <Border CornerRadius="18" BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0182136" Offset="0" />
                <GradientStop Color="#F00D111C" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#FF000000" Opacity="0.35" BlurRadius="26" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部输入区 -->
            <Grid Margin="22,20,22,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" FontSize="17" VerticalAlignment="Center" Foreground="#9AA5B5" />
                <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="17" FontWeight="SemiBold"
                         Foreground="#F0F3F8" CaretBrush="#4C7CF3" Background="Transparent"
                         BorderThickness="0" Margin="12,0,0,0"
                         TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
            </Grid>
            <!-- 分隔线：默认暗色，聚焦时变蓝紫渐变 -->
            <Border Grid.Row="1" Height="1" Margin="22,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#224C7CF3" Offset="0" />
                        <GradientStop Color="#228B5CF6" Offset="0.5" />
                        <GradientStop Color="#224C7CF3" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 结果区 -->
            <ScrollViewer Grid.Row="2" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,6">
                <StackPanel>
                    <!-- 应用搜索结果（单击启动） -->
                    <ItemsControl x:Name="SearchList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource HoverItemStyle}" Tag="{Binding}"
                                        Click="OnSearchResultClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" Foreground="#F0F3F8"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyText" Text="未找到匹配的应用" FontSize="12.5" Foreground="#7A8598"
                               Margin="24,12,0,14" Visibility="Collapsed" />

                    <!-- 剪贴板历史（单行卡片） -->
                    <TextBlock x:Name="ClipTitle" Text="剪贴板历史" FontSize="11.5" Foreground="#9AA5B5"
                               Margin="24,14,0,4" />
                    <ItemsControl x:Name="ClipList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource HoverItemStyle}" Tag="{Binding}"
                                        Click="OnClipItemClick">
                                    <Grid>
                                        <TextBlock Text="📋" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" FontSize="12.5" Foreground="#D8DEE8"
                                                   TextTrimming="CharacterEllipsis" Margin="32,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ClipEmpty" Text="（暂无剪贴板历史）" FontSize="12.5" Foreground="#7A8598"
                               Margin="24,4,0,12" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部功能区 -->
            <Border Grid.Row="3" Height="1" Margin="22,0" Background="#1EFFFFFF" />
            <Grid Grid.Row="4" Margin="16,10,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="📋  剪贴板" FontSize="12" Foreground="#D8DEE8"
                        Style="{StaticResource FooterButtonStyle}" Click="OnClipButtonClick" />
                <Button Grid.Column="1" Content="🤖  AI 对话" FontSize="12" Foreground="#D8DEE8"
                        Style="{StaticResource FooterButtonStyle}" Margin="10,0,0,0" Click="OnAIButtonClick" />
                <TextBlock Grid.Column="2" Text="Esc 关闭 · 回车启动 · 点击条目复制"
                           FontSize="10.5" Foreground="#7A8598" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="12,0,4,0" />
            </Grid>
        </Grid>
    </Border>
</widgets:WidgetWindowBase>
