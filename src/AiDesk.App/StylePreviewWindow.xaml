<Window x:Class="AiDesk.App.StylePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UI 风格预览 —— 请选择一套" Width="1240" Height="780"
        WindowStartupLocation="CenterScreen" Background="#FF101318">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🎨 第二批：三个不同方向（告诉我编号）" FontSize="17" FontWeight="SemiBold"
                       Foreground="#E8ECF4" VerticalAlignment="Center" />
            <TextBlock Text="   D Win11 Mica  ·  E 极简纯色  ·  F 明亮卡片" FontSize="12"
                       Foreground="#8A94A6" VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══════════ 面板 D：Win11 Mica（扁平、方角、系统蓝） ═══════════ -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="D · Win11 Mica（系统原生感）" FontSize="12.5" FontWeight="SemiBold" Foreground="#B8C0CE" Margin="4,0,0,8" />
                <Border CornerRadius="8" BorderBrush="#14000000" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFF5F5F5" Offset="0" />
                            <GradientStop Color="#FFE9EBEE" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#FF000000" Opacity="0.18" BlurRadius="18" ShadowDepth="0" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tab（Win11：小圆角 + 蓝字选中） -->
                        <Grid Margin="12,8,12,0">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Content="🔍 搜索" IsChecked="True" Foreground="#5F6368" FontSize="12" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1A0067C0" />
                                                    <Setter Property="Foreground" Value="#0067C0" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#12000000" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ToggleButton Content="📋 剪贴板" Foreground="#5F6368" FontSize="12" Cursor="Hand" Margin="4,0,0,0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1A0067C0" />
                                                    <Setter Property="Foreground" Value="#0067C0" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#12000000" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Text="✕" Foreground="#5F6368" FontSize="12" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                        </Grid>

                        <!-- 输入 -->
                        <Border Grid.Row="1" Margin="12,10,12,0" Background="#FFFFFFFF" CornerRadius="4" Padding="10,7"
                                BorderBrush="#14000000" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="13" Foreground="#5F6368" VerticalAlignment="Center" />
                                <TextBlock Text="excel" FontSize="13" Foreground="#202124" Margin="10,0,0,0"
                                           VerticalAlignment="Center" FontWeight="Medium" />
                            </StackPanel>
                        </Border>

                        <!-- 列表 + 预览 -->
                        <Grid Grid.Row="2" Margin="12,10,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Background="#1F0067C0" CornerRadius="4" Padding="10,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📘" FontSize="15" />
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="Microsoft Excel" FontSize="11.5" Foreground="#202124" />
                                            <TextBlock Text="Office 安装目录" FontSize="9.5" Foreground="#80868B" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="Transparent" CornerRadius="4" Padding="10,7" Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄" FontSize="15" />
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="Microsoft Word" FontSize="11.5" Foreground="#202124" />
                                            <TextBlock Text="Office 安装目录" FontSize="9.5" Foreground="#80868B" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="Transparent" CornerRadius="4" Padding="10,7" Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌐" FontSize="15" />
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="Microsoft Edge" FontSize="11.5" Foreground="#202124" />
                                            <TextBlock Text="Edge 安装目录" FontSize="9.5" Foreground="#80868B" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- 预览 -->
                            <Border Grid.Column="1" CornerRadius="4" Background="#FFFFFFFF" BorderBrush="#12000000"
                                    BorderThickness="1" Padding="12,10" Margin="8,0,0,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="📘" FontSize="32" HorizontalAlignment="Center" />
                                    <TextBlock Text="Microsoft Excel" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#202124" TextAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="应用程序" FontSize="9.5" Foreground="#80868B" TextAlignment="Center" Margin="0,3,0,0" />
                                    <Border Height="1" Background="#14000000" Margin="0,8,0,6" />
                                    <TextBlock Text="C:\Program Files\Microsoft Office\root\Office16\EXCEL.EXE"
                                               FontSize="8.5" Foreground="#5F6368" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 剪贴板标题 + 分页 -->
                        <Grid Grid.Row="3" Margin="14,12,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▾" Foreground="#80868B" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="剪贴板历史" FontSize="11" Foreground="#3C4043" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Text="共 12 条" FontSize="10" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="◀" Foreground="#80868B" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="1/2" FontSize="10.5" Foreground="#80868B" Margin="8,0" VerticalAlignment="Center" />
                                <TextBlock Text="▶" Foreground="#80868B" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- 剪贴板条目 + 底部 -->
                        <StackPanel Grid.Row="4" Margin="12,8,12,0">
                            <Border Background="#FFFFFFFF" CornerRadius="4" BorderBrush="#12000000" BorderThickness="1" Padding="10,7">
                                <TextBlock Text="📋 粘贴一段测试文本，用于观察列表效果" FontSize="11" Foreground="#3C4043" />
                            </Border>
                        </StackPanel>
                        <Border Grid.Row="5" Height="1" Background="#1C000000" Margin="12,12,12,0" />
                        <Grid Grid.Row="6" Margin="12,10,12,12">
                            <Button Content="🤖  AI 对话" HorizontalAlignment="Left" Background="#0067C0" Foreground="White"
                                    FontSize="11.5" Cursor="Hand" Padding="14,7">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#0057A8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="Esc 关闭 · ↑↓ 选择 · 回车启动" FontSize="10" Foreground="#9AA0A6"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ═══════════ 面板 E：极简纯色（无框无渐变） ═══════════ -->
            <StackPanel Grid.Column="1" Margin="6,0">
                <TextBlock Text="E · 极简纯色（Spotlight 风）" FontSize="12.5" FontWeight="SemiBold" Foreground="#B8C0CE" Margin="4,0,0,8" />
                <Border CornerRadius="12" Background="#FF161616">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF000000" Opacity="0.5" BlurRadius="30" ShadowDepth="0" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tab：白字选中 + 白色小圆点 -->
                        <Grid Margin="14,10,14,0">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Content="🔍 搜索" IsChecked="True" Foreground="#888888" FontSize="12" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Ellipse x:Name="dot" Width="4" Height="4" Fill="#FFFFFF"
                                                         VerticalAlignment="Center" Visibility="Collapsed" />
                                                <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                           FontSize="{TemplateBinding FontSize}" Margin="8,0,14,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ToggleButton Content="📋 剪贴板" Foreground="#888888" FontSize="12" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Ellipse x:Name="dot" Width="4" Height="4" Fill="#FFFFFF"
                                                         VerticalAlignment="Center" Visibility="Collapsed" />
                                                <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                           FontSize="{TemplateBinding FontSize}" Margin="8,0,14,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Text="✕" Foreground="#666666" FontSize="12" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                        </Grid>

                        <!-- 输入：无框，仅文字 -->
                        <Grid Grid.Row="1" Margin="18,14,18,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="16" Foreground="#888888" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="excel" FontSize="17" FontWeight="SemiBold" Foreground="#F5F5F5"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="2" Height="1" Background="#2A2A2A" Margin="18,0" />

                        <!-- 列表 + 预览 -->
                        <Grid Grid.Row="3" Margin="10,10,10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Background="#2E2E2E" CornerRadius="8" Padding="12,9">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📘" FontSize="15" />
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="Microsoft Excel" FontSize="12" Foreground="#FFFFFF" />
                                            <TextBlock Text="Office 安装目录" FontSize="9.5" Foreground="#777777" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="8" Padding="12,9" Margin="0,3,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄" FontSize="15" />
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="Microsoft Word" FontSize="12" Foreground="#E8E8E8" />
                                            <TextBlock Text="Office 安装目录" FontSize="9.5" Foreground="#777777" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="8" Padding="12,9" Margin="0,3,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌐" FontSize="15" />
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="Microsoft Edge" FontSize="12" Foreground="#E8E8E8" />
                                            <TextBlock Text="Edge 安装目录" FontSize="9.5" Foreground="#777777" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- 预览 -->
                            <Border Grid.Column="1" CornerRadius="8" Background="#FF1D1D1D" Padding="12,10"
                                    Margin="8,0,0,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="📘" FontSize="30" HorizontalAlignment="Center" />
                                    <TextBlock Text="Microsoft Excel" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#FFFFFF" TextAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="应用程序" FontSize="9.5" Foreground="#777777" TextAlignment="Center" Margin="0,3,0,0" />
                                    <Border Height="1" Background="#2A2A2A" Margin="0,8,0,6" />
                                    <TextBlock Text="C:\Program Files\Microsoft Office\root\Office16\EXCEL.EXE"
                                               FontSize="8.5" Foreground="#999999" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 剪贴板标题 + 分页 -->
                        <Grid Grid.Row="4" Margin="16,4,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▾" Foreground="#888888" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="剪贴板历史" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Text="共 12 条" FontSize="10" Foreground="#666666" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="◀" Foreground="#666666" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="1/2" FontSize="10.5" Foreground="#888888" Margin="8,0" VerticalAlignment="Center" />
                                <TextBlock Text="▶" Foreground="#666666" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- 剪贴板条目 -->
                        <StackPanel Grid.Row="5" Margin="14,8,14,10">
                            <Border CornerRadius="8" Padding="12,9">
                                <TextBlock Text="📋 粘贴一段测试文本，用于观察列表效果" FontSize="11" Foreground="#BBBBBB" />
                            </Border>
                            <Grid Margin="0,8,0,0">
                                <Button Content="AI 对话" HorizontalAlignment="Left" Background="#FFFFFF" Foreground="#161616"
                                        FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Padding="14,6">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#DDDDDD" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="Esc 关闭 · ↑↓ 选择 · 回车启动" FontSize="10" Foreground="#666666"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ═══════════ 面板 F：明亮卡片（Material） ═══════════ -->
            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                <TextBlock Text="F · 明亮卡片（Material）" FontSize="12.5" FontWeight="SemiBold" Foreground="#B8C0CE" Margin="4,0,0,8" />
                <Border CornerRadius="16" Background="#FFFFFFFF">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF3A4B66" Opacity="0.22" BlurRadius="22" ShadowDepth="2" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tab -->
                        <Grid Margin="16,12,16,0">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Content="🔍 搜索" IsChecked="True" Foreground="#5F6368" FontSize="12" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                           FontSize="{TemplateBinding FontSize}" Margin="0,0,16,6" VerticalAlignment="Center" />
                                                <Border x:Name="line" Height="3" Width="20" Background="#1A73E8" CornerRadius="2"
                                                        HorizontalAlignment="Center" Visibility="Collapsed" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="txt" Property="Foreground" Value="#1A73E8" />
                                                    <Setter TargetName="txt" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="line" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ToggleButton Content="📋 剪贴板" Foreground="#5F6368" FontSize="12" Cursor="Hand" Margin="8,0,0,0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                           FontSize="{TemplateBinding FontSize}" Margin="0,0,16,6" VerticalAlignment="Center" />
                                                <Border x:Name="line" Height="3" Width="20" Background="#1A73E8" CornerRadius="2"
                                                        HorizontalAlignment="Center" Visibility="Collapsed" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="txt" Property="Foreground" Value="#1A73E8" />
                                                    <Setter TargetName="txt" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="line" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Text="✕" Foreground="#9AA0A6" FontSize="12" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                        </Grid>

                        <!-- 输入：白卡片 -->
                        <Border Grid.Row="1" Margin="16,10,16,0" Background="#FFF1F3F4" CornerRadius="10" Padding="12,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="13" Foreground="#5F6368" VerticalAlignment="Center" />
                                <TextBlock Text="excel" FontSize="13.5" Foreground="#202124" Margin="10,0,0,0"
                                           VerticalAlignment="Center" FontWeight="Medium" />
                            </StackPanel>
                        </Border>

                        <!-- 列表 + 预览 -->
                        <Grid Grid.Row="2" Margin="16,12,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Background="#E8F0FE" CornerRadius="10" Padding="12,9">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📘" FontSize="15" />
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="Microsoft Excel" FontSize="11.5" FontWeight="Medium" Foreground="#202124" />
                                            <TextBlock Text="Office 安装目录" FontSize="9.5" Foreground="#80868B" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF8F8F8" CornerRadius="10" Padding="12,9" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄" FontSize="15" />
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="Microsoft Word" FontSize="11.5" FontWeight="Medium" Foreground="#202124" />
                                            <TextBlock Text="Office 安装目录" FontSize="9.5" Foreground="#80868B" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF8F8F8" CornerRadius="10" Padding="12,9" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌐" FontSize="15" />
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="Microsoft Edge" FontSize="11.5" FontWeight="Medium" Foreground="#202124" />
                                            <TextBlock Text="Edge 安装目录" FontSize="9.5" Foreground="#80868B" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- 预览 -->
                            <Border Grid.Column="1" CornerRadius="10" Background="#FFF8F9FA" BorderBrush="#14000000"
