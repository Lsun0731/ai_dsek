<UserControl x:Class="AiDesk.App.Views.DesktopDockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="桌面 Dock" Style="{StaticResource PageTitle}" />
            <TextBlock Text="在原桌面上集成：运行中应用磁贴、应用搜索、音乐监控。壁纸 / 图标 / 右键菜单全部保留。"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,24,0,0">
            <StackPanel>
                <!-- 启用 Dock -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="启用桌面 Dock" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="底部磁贴条：显示运行中的应用，点击切换；含搜索按钮与音乐卡片。挂载在桌面图层（应用窗口之下）。"
                                   Style="{StaticResource CardDesc}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleButton}"
                                  IsChecked="{Binding DockEnabled}" VerticalAlignment="Center" />
                </Grid>

                <!-- 隐藏任务栏 -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="隐藏系统任务栏" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="用桌面 Dock 替代任务栏（可随时关闭恢复）。"
                                   Style="{StaticResource CardDesc}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleButton}"
                                  IsChecked="{Binding HideTaskbar}" VerticalAlignment="Center" />
                </Grid>

                <!-- 隐藏桌面图标 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="隐藏桌面图标" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="让桌面更干净（可选，随时可恢复）。"
                                   Style="{StaticResource CardDesc}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleButton}"
                                  IsChecked="{Binding HideIcons}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
