<UserControl x:Class="AiDesk.App.Views.CursorThemePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="960">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="光标主题" Style="{StaticResource PageTitle}" />
            <TextBlock Text="切换系统已安装的光标方案，安全可逆" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 方案列表 -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="已安装的方案" FontSize="13" Foreground="#4A515B" Margin="4,0,0,8" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Schemes}" SelectedItem="{Binding SelectedScheme}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F1F3F8" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#EAF0FE" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock FontSize="12" Foreground="#8A9099">
                            <Run Text="当前使用：" /><Run Text="{Binding CurrentScheme}" FontWeight="SemiBold" Foreground="#4A515B" />
                        </TextBlock>
                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#8A9099" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 操作区 -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                <StackPanel>
                    <TextBlock Text="操作" FontSize="13" Foreground="#4A515B" Margin="0,0,0,14" />
                    <Button Content="应用所选方案" Command="{Binding ApplyCommand}"
                            Style="{StaticResource ButtonPrimary}" Height="36" HorizontalAlignment="Stretch" />
                    <Button Content="恢复 Windows 默认" Command="{Binding RestoreDefaultCommand}"
                            Style="{StaticResource ButtonDefault}" Height="36" HorizontalAlignment="Stretch"
                            Margin="0,10,0,0" />
                    <Button Content="刷新列表" Command="{Binding RefreshCommand}"
                            Style="{StaticResource ButtonDefault}" Height="36" HorizontalAlignment="Stretch"
                            Margin="0,10,0,0" />
                    <TextBlock Text="提示：应用后光标会立即切换；恢复默认回到系统标准光标。"
                               FontSize="12" Foreground="#8A9099" TextWrapping="Wrap" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
