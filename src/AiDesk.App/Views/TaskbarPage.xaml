<UserControl x:Class="AiDesk.App.Views.TaskbarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="960">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="任务栏美化" Style="{StaticResource PageTitle}" />
            <TextBlock Text="任务栏透明 / 毛玻璃 / 亚克力特效（部分 Windows 11 版本可能不支持）" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,24,0,0" Style="{StaticResource ModernCard}" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="特效类型" FontSize="13" Foreground="#4A515B" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}"
                         DisplayMemberPath="Display" BorderThickness="0" Background="Transparent" MaxWidth="320">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F1F3F8" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#EAF0FE" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock Text="着色强度（透明 / 亚克力有效）" FontSize="13" Foreground="#4A515B" Margin="0,18,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="100" Value="{Binding TintStrength}"
                            IsSnapToTickEnabled="True" TickFrequency="5" />
                    <TextBlock Grid.Column="1" Text="{Binding TintStrength, StringFormat={}{0}%}"
                               VerticalAlignment="Center" TextAlignment="Right" FontSize="13" Foreground="#8A9099" />
                </Grid>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="应用特效" Command="{Binding ApplyCommand}"
                            Style="{StaticResource ButtonPrimary}" Padding="24,0" Height="36" />
                    <Button Grid.Column="1" Content="恢复默认" Command="{Binding ResetCommand}"
                            Style="{StaticResource ButtonDefault}" Margin="10,0,0,0" Padding="20,0" Height="36" />
                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#8A9099" FontSize="12"
                               Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
