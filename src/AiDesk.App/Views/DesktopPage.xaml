<UserControl x:Class="AiDesk.App.Views.DesktopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="960">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel>
            <TextBlock Text="桌面美化" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="壁纸、轮播与外观模式个性化设置"
                       Foreground="#8A9099" FontSize="13" Margin="0,6,0,0" />
        </StackPanel>

        <!-- 三张功能卡片 -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 卡片 1：壁纸 -->
            <hc:Card Grid.Column="0" Padding="20">
                <StackPanel>
                    <TextBlock Text="壁纸" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="选择图片并应用到桌面" Foreground="#9AA1AB" FontSize="12" Margin="0,4,0,14" />

                    <TextBlock Text="当前壁纸" FontSize="12" Foreground="#9AA1AB" />
                    <TextBlock Text="{Binding WallpaperPath}" FontSize="12" Foreground="#4A515B"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding WallpaperPath}"
                               Margin="0,4,0,12" MaxHeight="40" />

                    <Button Content="选择图片…" Command="{Binding SelectWallpaperCommand}"
                            Style="{StaticResource ButtonDefault}" Height="34" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding WallpaperPath}" FontSize="11" Foreground="#8A9099"
                               TextTrimming="CharacterEllipsis" Margin="0,6,0,10" />

                    <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}"
                              DisplayMemberPath="Display" Height="34" Margin="0,0,0,10" />

                    <Button Content="应用壁纸" Command="{Binding ApplyWallpaperCommand}"
                            Style="{StaticResource ButtonPrimary}" Height="36" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding WallpaperStatus}" FontSize="12" Foreground="#8A9099"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </hc:Card>

            <!-- 卡片 2：壁纸轮播 -->
            <hc:Card Grid.Column="2" Padding="20">
                <StackPanel>
                    <TextBlock Text="壁纸轮播" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="定时自动切换文件夹中的壁纸" Foreground="#9AA1AB" FontSize="12" Margin="0,4,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="启用轮播" VerticalAlignment="Center" FontSize="13" />
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleButton}"
                                      IsChecked="{Binding SlideshowEnabled}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="随机顺序" VerticalAlignment="Center" FontSize="13" />
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleButton}"
                                      IsChecked="{Binding SlideshowShuffle}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="间隔" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0" />
                        <hc:NumericUpDown Grid.Column="1" Value="{Binding SlideshowIntervalMinutes}"
                                          Minimum="1" Maximum="1440" Increment="5" Height="32" />
                        <TextBlock Grid.Column="2" Text="分钟" VerticalAlignment="Center" FontSize="12"
                                   Foreground="#8A9099" Margin="8,0,0,0" />
                    </Grid>

                    <Button Content="选择文件夹…" Command="{Binding SelectSlideshowFolderCommand}"
                            Style="{StaticResource ButtonDefault}" Height="34" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding SlideshowFolder}" FontSize="11" Foreground="#8A9099"
                               TextTrimming="CharacterEllipsis" Margin="0,6,0,10" />

                    <Button Content="立即切换一张" Command="{Binding NextWallpaperCommand}"
                            Style="{StaticResource ButtonDefault}" Height="34" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding SlideshowStatus}" FontSize="12" Foreground="#8A9099"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </hc:Card>

            <!-- 卡片 3：外观模式 -->
            <hc:Card Grid.Column="4" Padding="20">
                <StackPanel>
                    <TextBlock Text="外观模式" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="深浅色、透明度与强调色" Foreground="#9AA1AB" FontSize="12" Margin="0,4,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="深色模式" FontSize="13" />
                            <TextBlock Text="应用与系统主题" FontSize="11" Foreground="#9AA1AB" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleButton}"
                                      IsChecked="{Binding DarkMode}" Click="OnDarkModeClicked" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="任务栏透明度" FontSize="13" />
                            <TextBlock Text="半透明效果" FontSize="11" Foreground="#9AA1AB" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleButton}"
                                      IsChecked="{Binding TransparencyEnabled}" Click="OnTransparencyClicked" />
                    </Grid>

                    <TextBlock Text="强调色" FontSize="13" Margin="0,4,0,8" />
                    <ItemsControl ItemsSource="{Binding PresetColors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ColorSwatchButton}"
                                        Background="{Binding}"
                                        Click="OnColorClicked"
                                        ToolTip="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="当前强调色" FontSize="12" Foreground="#9AA1AB" Margin="0,6,0,4" />
                    <Rectangle Height="22" RadiusX="6" RadiusY="6">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="{Binding AccentColor}" />
                        </Rectangle.Fill>
                    </Rectangle>

                    <Button Content="应用强调色" Command="{Binding ApplyAccentColorCommand}"
                            Style="{StaticResource ButtonPrimary}" Height="36" HorizontalAlignment="Stretch"
                            Margin="0,10,0,0" />
                    <TextBlock Text="{Binding AppearanceStatus}" FontSize="12" Foreground="#8A9099"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </hc:Card>
        </Grid>
    </Grid>
</UserControl>
