<Window x:Class="AiDesk.App.SecondDesktop.SecondDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiDesk 第二桌面"
        WindowStyle="None" WindowState="Maximized" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="#101522"
        KeyDown="OnWindowKeyDown"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">
    <Window.Resources>
        <!-- 磁贴按钮样式：深色卡片 + 悬停高亮 -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="104" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#1A2130" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="14" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26324A" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4C7CF3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F2A40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 音乐控制小按钮 -->
        <Style x:Key="MusicControlButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3A58" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="56,32,56,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部栏：返回 + 标题 + 音乐卡片 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="←  返回原桌面" FontSize="14" Foreground="#B8C0CC"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Padding="12,8" Click="OnBackClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A2130" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Grid.Column="1" Text="第二桌面" FontSize="22" FontWeight="SemiBold"
                       Foreground="#E8ECF2" VerticalAlignment="Center" Margin="16,0,0,0" />

            <!-- 音乐监控卡片 -->
            <Border Grid.Column="2" Background="#1A2130" CornerRadius="14"
                    BorderBrush="#26FFFFFF" BorderThickness="1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image x:Name="MusicCover" Width="52" Height="52" Stretch="UniformToFill"
                           Source="{x:Null}" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="pack://application:,,,/Assets/ai-desk.ico" />
                            </Style>
                        </Image.Style>
                    </Image>

                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="MusicTitle" Text="未在播放" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#E8ECF2" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MusicArtist" Text="正在监听系统媒体…" FontSize="11"
                                   Foreground="#8A94A3" Margin="0,3,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="⏮" Style="{StaticResource MusicControlButton}" Click="OnPrevClicked" ToolTip="上一首" />
                            <Button x:Name="PlayBtn" Content="▶" Style="{StaticResource MusicControlButton}" Margin="6,0,0,0"
                                    Click="OnPlayClicked" ToolTip="播放/暂停" />
                            <Button Content="⏭" Style="{StaticResource MusicControlButton}" Margin="6,0,0,0"
                                    Click="OnNextClicked" ToolTip="下一首" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 搜索框 -->
        <Grid Grid.Row="1" Margin="0,28,0,0">
            <TextBox x:Name="SearchBox" FontSize="16" Foreground="#E8ECF2" CaretBrush="#4C7CF3"
                     Background="#1A2130" BorderBrush="#26FFFFFF" BorderThickness="1"
                     Padding="18,14" VerticalContentAlignment="Center"
                     TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <TextBlock Text="🔍  搜索应用…" Foreground="#5A6478" FontSize="15"
                                           VerticalAlignment="Center" Margin="18,0,0,0"
                                           Visibility="Collapsed" x:Name="Placeholder" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="18,0,18,0"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>

            <!-- 搜索结果 -->
            <ListBox x:Name="SearchList" MaxHeight="280" Margin="0,8,0,0"
                     Background="#1A2130" BorderBrush="#26FFFFFF" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="Collapsed" MouseDoubleClick="OnSearchResultDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,4">
                            <TextBlock Text="📄" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#E8ECF2"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 磁贴区 -->
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="正在运行" FontSize="15" FontWeight="SemiBold" Foreground="#C8D0DC" />
                <TextBlock Grid.Column="1" x:Name="CountText" Text="" FontSize="12" Foreground="#6A7488" />
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TilesHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButton}"
                                    Click="OnTileClick" Tag="{Binding ProcessId}">
                                <StackPanel>
                                    <Image Source="{Binding Icon}" Width="40" Height="40" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Title}" FontSize="11" Foreground="#C8D0DC"
                                               TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32"
                                               Margin="6,8,6,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="3" Text="Esc 返回原桌面  ·  点击磁贴切换应用  ·  Ctrl+Alt+D 随时呼出"
                   FontSize="12" Foreground="#5A6478" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </Grid>
</Window>
