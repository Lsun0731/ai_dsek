<Window x:Class="AiDesk.App.DesktopDock.DesktopDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiDesk 桌面Dock"
        WindowStyle="None" Background="#E810141E"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="False"
        Height="96" SizeToContent="Width">
    <!-- 注意：不用 AllowsTransparency——分层窗口 SetParent 到 WorkerW 会渲染空白（磁贴不显示）。
         背景用不透明深色（alpha 忽略），圆角由内部 Border 承担 -->
    <Border Background="#F810141E" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,1" Padding="20,8">
        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TilesHost">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="64" Height="64" Margin="0,0,10,0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0"
                                Click="OnTileClick" Tag="{Binding ProcessId}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Title}" FontSize="9" Foreground="#C8D0DC"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="60"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</Window>
