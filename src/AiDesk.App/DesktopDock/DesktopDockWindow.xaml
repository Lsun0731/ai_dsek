<Window x:Class="AiDesk.App.DesktopDock.DesktopDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiDesk 桌面Dock"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="False"
        Height="104" SizeToContent="Width">
    <Border Background="#CC10141E" CornerRadius="18" BorderBrush="#33FFFFFF" BorderThickness="1"
            Padding="18,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：搜索 + 音乐 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SearchBtn" Content="🔍" Width="44" Height="44" FontSize="18"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="搜索应用（Ctrl+Alt+D）" Click="OnSearchClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#22FFFFFF" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#334C7CF3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- 中部：运行中应用磁贴 -->
            <ScrollViewer Grid.Column="1" Margin="14,0" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TilesHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="60" Height="60" Margin="0,0,8,0" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Click="OnTileClick" Tag="{Binding ProcessId}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Title}" FontSize="9" Foreground="#C8D0DC"
                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="56"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 右侧：音乐卡片（紧凑） -->
            <Border Grid.Column="2" Background="#1A2130" CornerRadius="12" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="MusicCover" Width="40" Height="40" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="MusicTitle" Text="未在播放" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#E8ECF2" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MusicArtist" Text="" FontSize="9" Foreground="#8A94A3"
                                       Margin="0,2,0,0" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="⏮" Width="20" Height="20" FontSize="9" Background="Transparent"
                                    BorderThickness="0" Foreground="#CCFFFFFF" Cursor="Hand" Click="OnPrevClicked" />
                            <Button x:Name="PlayBtn" Content="▶" Width="20" Height="20" FontSize="9" Background="Transparent"
                                    BorderThickness="0" Foreground="#CCFFFFFF" Cursor="Hand" Margin="4,0,0,0" Click="OnPlayClicked" />
                            <Button Content="⏭" Width="20" Height="20" FontSize="9" Background="Transparent"
                                    BorderThickness="0" Foreground="#CCFFFFFF" Cursor="Hand" Margin="4,0,0,0" Click="OnNextClicked" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
